{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec 'tsx src/index.ts'",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "shared": "workspace:*",
    "bullmq": "^5.76.2",
    "ioredis": "^5.10.1",
    "@anthropic-ai/sdk": "^0.91.1"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "@types/node": "^22.0.0",
    "nodemon": "^3.0.0",
    "tsx": "^4.0.0",
    "vitest": "^4.1.5"
  }
}
